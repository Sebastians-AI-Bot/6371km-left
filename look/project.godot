; Engine configuration file.
; 6.371 km — look prototype (visual target only).

config_version=5

[application]

config/name="6.371 km Look"
config/description="Look prototype: miniature earth-block diorama. No gameplay."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=1500
window/size/viewport_height=1000
